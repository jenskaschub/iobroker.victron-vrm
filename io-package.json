{
  "common": {
    "name": "victron-vrm",
    "version": "0.2.0",
    "news": {
      "0.2.0": {
        "en": "Added PV Solar Forecast and consumption forecast tracking via the VRM Stats endpoint.",
        "de": "PV-Solarprognose und Verbrauchsprognose über den VRM-Stats-Endpunkt hinzugefügt."
      },
      "0.1.0": {
        "en": "Initial release fetching diagnostic logs via Cloud API.",
        "de": "Erste Version zum Abrufen von Diagnoseprotokollen über die Cloud-API."
      }
    },
    "titleLang": {
      "en": "Victron VRM API Data Import",
      "de": "Victron VRM API Datenimport"
    },
    "desc": {
      "en": "Imports diagnostics, solar production forecasts, and consumption forecasts from the Victron VRM Portal.",
      "de": "Importiert Diagnosedaten, Solarertragsprognosen und Verbrauchsprognosen aus dem Victron VRM-Portal."
    },
    "authors": [
      "jenskaschub <jens@kaschub.de>"
    ],
    "keywords": [
      "victron",
      "vrm",
      "solar",
      "forecast",
      "ess",
      "energy"
    ],
    "license": "MIT",
    "licenseInformation": {
      "license": "MIT",
      "link": "https://opensource.org"
    },
    "platform": "Javascript/Node.js",
    "main": "main.js",
    "icon": "victron-vrm.png",
    "enabled": true,
    "extIcon": "https://githubusercontent.com",
    "readme": "https://github.com",
    "loglevel": "info",
    "mode": "daemon",
    "type": "energy",
    "tier": 3,
    "compact": true,
    "connectionType": "cloud",
    "dataSource": "poll",
    "adminUI": {
      "config": "html"
    },
    "dependencies": [
      {
        "js-controller": ">=5.0.0"
      }
    ]
  },
  "native": {
    "token": "",
    "idSite": "",
    "interval": 30
  },
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "API connection status",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
}
